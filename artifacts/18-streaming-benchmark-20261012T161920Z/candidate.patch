diff --git a/src/neural_generator.c b/src/neural_generator.c
index f420444..b38cb34 100644
--- a/src/neural_generator.c
+++ b/src/neural_generator.c
@@ -801,9 +801,17 @@ static void apply_adain(const GeneratorAdaIN *norm, const float *input, const fl
         float inverse_scale = (float)(1.0 / sqrt(variance + GENERATOR_ADAIN_EPSILON));
         float gamma = affine[channel];
         float beta = affine[channels + channel];
+#ifdef KOKORO_ADAIN_FUSED_AFFINE_EXPERIMENT
+        float output_scale = (1.0f + gamma) * inverse_scale;
+        float output_offset = beta - mean * output_scale;
+        for (size_t frame = 0; frame < frame_count; frame++) {
+            target[frame] = source[frame] * output_scale + output_offset;
+        }
+#else
         for (size_t frame = 0; frame < frame_count; frame++) {
             float normalized = (source[frame] - mean) * inverse_scale;
             target[frame] = (1.0f + gamma) * normalized + beta;
         }
+#endif
     }
